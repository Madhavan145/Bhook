# Shared multi-stage Dockerfile for every Bhook Spring Boot service.
# Build from repo root: docker build -f infra/docker/Dockerfile.service --build-arg SERVICE=identity -t bhook/identity .

FROM maven:3.9.9-eclipse-temurin-21 AS builder
WORKDIR /workspace
COPY services /workspace/services
ARG SERVICE
RUN --mount=type=cache,target=/root/.m2 \
    cd services && mvn -pl ${SERVICE} -am -DskipTests -B package

FROM eclipse-temurin:21-jre
ARG SERVICE
WORKDIR /app
COPY --from=builder /workspace/services/${SERVICE}/target/bhook-*.jar /app/app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
